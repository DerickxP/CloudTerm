# ══════════════════════════════════════════════════════════════
# CloudTerm — Variáveis de Ambiente
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores abaixo com suas credenciais
# 3. NUNCA commite o .env.local — ele já está no .gitignore
#
# Para fazer o deploy na Vercel, adicione essas mesmas variáveis
# em: Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# Supabase — URL pública do projeto
# Encontre em: supabase.com → seu projeto → Project Settings → General
# Formato: https://XXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — Chave pública (anon)
# Encontre em: Project Settings → API Keys → Legacy → anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Chave secreta (service_role) ⚠️ NUNCA exponha no front-end
# Encontre em: Project Settings → API Keys → Legacy → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Token de autenticação do agente local (qualquer string aleatória forte)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET_TOKEN=
